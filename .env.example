# Put your YouTube stream key here; never commit the populated .env file.
YOUTUBE_STREAM_KEY=
YOUTUBE_STREAM_URL=rtmp://a.rtmp.youtube.com/live2
YOUTUBE_RTMP_URL=
YOUTUBE_VERTICAL_RTMP_URL=
YOUTUBE_VERTICAL_STREAM_URL=rtmp://a.rtmp.youtube.com/live2
STREAM_LAYOUT=vertical

# Optional: comma-separated HTTPS URLs serving one or more PGN games.
HISTORICAL_PGN_URLS=

# Optional overrides. The project bundles a music loop and defaults to 0.22 volume.
MUSIC_VOLUME=0.22
HISTORICAL_MOVE_DELAY=8
STOCKFISH_DEPTH=12

# Scheduling requires a YouTube Data API Desktop OAuth client JSON file.
YOUTUBE_CLIENT_SECRETS=client_secret.json
YOUTUBE_OAUTH_PORT=8080